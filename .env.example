# Copy to .env and fill in. Never commit real values (Section 13.1).
# Production values live in GitHub Secrets / the hosting provider.

# ---- Arc chain ----
# Canonical values live in packages/shared/src/chains.ts; these are here for
# tooling that reads the environment. Verified 2026-09-21 from docs.arc.io.
#
#   testnet  rpc https://rpc.testnet.arc.io  chain 5042002
#            explorer https://explorer.testnet.arc.io  faucet https://faucet.circle.com
#   mainnet  rpc https://rpc.mainnet.arc.io  chain 5042
#            explorer https://explorer.arc.io
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# USDC on Arc has two views of one balance: the native gas token is 18 decimals,
# the ERC-20 interface at this address is 6. Contracts move money through the
# ERC-20 interface, so amounts are 6-decimal base units (brief Section 10).
USDC_ADDRESS=0x3600000000000000000000000000000000000000
RAFFLE_CONTRACT_ADDRESS=

# The randomness adapter (Section 11.1). Section 13.6's low-balance alert reads
# feeBalance() and requestsAffordable() from it.
ADAPTER_ADDRESS=

# Required by packages/contracts/script/Deploy.s.sol. It checks both are set,
# and that USDC and the VRF coordinator are actually contracts on the target
# chain, before broadcasting anything.
TREASURY_ADDRESS=
OWNER_ADDRESS=

# ---- Randomness (Section 11.1) ----
# D20DAO VRF coordinator *proxy*, not the implementation. Check against the
# deployment manifest rather than trusting a pasted address:
#   testnet  https://d20dao.org/deployments/arc-testnet.json
#   mainnet  https://d20dao.org/deployments/arc-mainnet.json
# Testnet: 0xd20DA0FF9087d053f0291524Eac12abA1ADBd945  (min fee 0.08 USDC)
# Mainnet: 0xd20da057469C45928912d983F45790C41e290571  (min fee 0.02 USDC)
#
# Resolved: the manifest address IS the coordinator. Requests seen going to
# 0xD20da026090B8472579a2B93030F1fC4c94807F1 came from a consumer app that
# forwards to it. See brief Section 11.1.
#
# The adapter pays each request's fee from a float held at its own address, in
# native 18-decimal units. Default below buys roughly 25 draws at 0.08 each.
ADAPTER_FLOAT_WEI=2000000000000000000
VRF_COORDINATOR_ADDRESS=0xd20DA0FF9087d053f0291524Eac12abA1ADBd945

# Arc's mempool silently DROPS transactions whose maxFeePerGas is under this.
# There is no error to catch: the transaction simply never appears.
ARC_MIN_BASE_FEE_GWEI=20

# ---- Deploy keys ----
# PREFER LEAVING THIS EMPTY. Foundry reads an encrypted keystore instead:
#
#   cast wallet import stubby-owner --interactive
#   forge script ... --account stubby-owner
#
# A key here is in the environment of every process started after
# `set -a && . ./.env`, on disk in every backup, and readable by anything that
# can read a file in this directory — including a dependency postinstall.
# `pnpm check:env` warns while it is set, and fails if ARC_CHAIN_ID is mainnet.
# See docs/key-management.md.
DEPLOYER_PRIVATE_KEY=

# The deploy key stays in this file, deliberately (decided 2026-09-22).
#
# Set to the date the decision was made. It downgrades `check:env`'s warning to
# a note — the note still prints, so a fresh clone or a new machine without this
# line gets the full warning and the risk never disappears from view.
#
# What is being accepted: this key owns the mainnet contract, and with it
# createRaffle, withdrawCommission, setTreasury, setEntriesPaused and
# transferOwnership. Anything that can read a file in this directory can take
# all of that. See docs/key-management.md.
DEPLOYER_KEY_IN_FILE_ACCEPTED=


# ---- API ----
# Postgres. Ours, on the VPS in production (ADR 0009); in development, the
# throwaway container that `scripts/dev-db.sh` starts for you.
#
# Nothing here is Supabase-specific and nothing should become so: plain SQL, a
# standard driver, migrations the project owns. That constraint is what made
# moving off Supabase a one-line change, and it is what keeps the next move
# cheap too.
#
# `scripts/dev-db.sh` prints this exact line, so the usual answer is to run it
# rather than to edit this by hand. Port 55432 rather than 5432 so it cannot
# collide with a Postgres already installed on your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/stubby?sslmode=disable

# The CA certificate the database's own certificate is signed by.
#
# Set, the API verifies the far end is really the database. Unset, it still
# encrypts but verifies nothing — which is not good enough in production,
# because this connection carries every nonce and every wallet address.
#
# In production this is the self-signed certificate Postgres holds on the VPS,
# copied to a path the API can read. The local development container speaks no
# TLS at all, hence `sslmode=disable` above, and this stays empty.
DATABASE_CA_CERT=

PORT=3000

# Origins the browser app is served from, comma-separated.
#
# An explicit list, never `*`. The session is a cookie, and a browser refuses to
# send credentials to a wildcard origin — so `*` here would not loosen the
# policy, it would silently stop sign-in working. Expo serves web on 8081.
ALLOWED_ORIGINS=http://localhost:8081

# How many reverse proxies sit in front of the API.
#
# 0 (the default) means the API is exposed directly, so `X-Forwarded-For` is
# IGNORED. That header is a client-supplied string: trusting it when nothing
# appends it lets anyone send a different value per request and get a fresh
# rate-limit bucket every time, which makes the limit decorative.
#
# Behind one proxy that appends the real peer address, set 1. The client address
# is then read from the RIGHT of the chain, so a forged prefix cannot shift it.
# Too low limits everyone together; too high reads a value the client controls.
# Too low is the safe direction.
TRUSTED_PROXIES=0


# ---- Auth (Section 10) ----
# ---- Email login (Section 4.1) ----
# Passwordless: the API mails a single-use link that expires in ten minutes.
#
# SMTP_HOST and MAIL_FROM together turn on real delivery (ADR 0010). Setting one
# without the other stops the process at startup rather than falling back: a
# deployment that believes it is sending mail and is not is precisely the
# failure this area is arranged to prevent.
#
# With both empty, development prints the link to the API's own output — better
# than pointing a provider at your own inbox — and production refuses to send at
# all, answering 502. Never a mailer that accepts and delivers nothing: that
# looks identical to a working system from outside, and is the worse failure.
#
# In production the relay is Postfix on the VPS's own loopback, which holds the
# DKIM key and does the delivery. Nothing here carries a credential, because
# there is no network between the API and the relay.
SMTP_HOST=
SMTP_PORT=25

# The sender, as the reader sees it. A display name is fine.
#   MAIL_FROM=Stubby <noreply@stubby.starterdot.com>
#
# The domain must be one the relay is allowed to sign for, or the mail is sent
# unsigned and lands in spam. See docs/deploying.md.
MAIL_FROM=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# The EIP-4361 `domain`: the authority the wallet is asked to sign for. It is
# an authority, NOT a URL — no scheme, no path — and it must equal the host
# the page is actually served from, port included, or every signature is
# rejected. Expo serves web on 8081 by default, so localhost:8081 locally;
# in production, the real host, e.g. stubby.app.
SIWE_DOMAIN=

# ---- Wallet connection ----
WALLETCONNECT_PROJECT_ID=

# ---- Geo-restriction at deposit time (Section 11.9) ----
# proxycheck.io: VPN, proxy, Tor and relay flags plus the country, on a free
# tier of 1000 queries a day. That is ample, because Section 11.9 checks at
# deposit time only, not while browsing. Note that ipinfo.io's free tier is
# geolocation ONLY — its VPN flags need a paid plan.
#   https://proxycheck.io/dashboard/
IP_INTELLIGENCE_API_KEY=

# ISO 3166-1 alpha-2, comma separated. Compared against proxycheck's `isocode`.
#
# Set explicitly below. This mirrors the reviewed default in
# packages/shared/src/geo.ts, which carries a source and a reason for every
# entry — keep the two in step, or unset this line to defer to it. An empty
# value is NOT the same as unset: empty blocks nobody, deliberately.
#
#   sanctions, mechanical : CU IR KP SY  (OFAC comprehensive)
#                           MM           (FATF call for action)
#   licensing, a judgement: US GB AU SG FR NL BE IT ES
#
# The licensing tier removes the largest markets and is a starting point from
# published sources, not legal advice. Review it with a lawyer before launch
# rather than inheriting it.
BLOCKED_COUNTRY_CODES=CU,IR,KP,SY,MM,US,GB,AU,SG,FR,NL,BE,IT,ES

# ---- Observability (Section 13.6) ----
# https://sentry.io -> your project -> Settings -> Client Keys (DSN)
#
# A DSN is not a secret: it permits submitting events, never reading them, and
# it ships inside the app bundle by design. The real exposure is quota abuse.
#
# TWO VARIABLES, DELIBERATELY. Expo only exposes EXPO_PUBLIC_* to the client
# bundle, so a DSN named SENTRY_DSN would be silently undefined in the app and
# nothing would ever be reported — a failure that looks like "no errors
# happened". The API reads SENTRY_DSN; the app reads EXPO_PUBLIC_SENTRY_DSN.
# They can hold the same value or point at separate Sentry projects.
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Tags events so staging noise is separable from production.
EXPO_PUBLIC_ENVIRONMENT=development

# ---- App bundle (Section 10) ----
# Expo exposes ONLY `EXPO_PUBLIC_*` to the client, so anything the app itself
# needs is duplicated here with the prefix. Treat every value below as public:
# it ships inside the JavaScript bundle and can be read by anyone.
#
# WalletConnect's project id is public by design — it identifies the dapp to the
# relay, and every dapp's bundle carries one. The unprefixed copy above is for
# the API.
#
# NOT YET READ BY THE WEB BUILD. wagmi's walletConnect connector is deprecated
# for a vulnerable transitive dependency, cannot be imported without pulling in
# `porto`, which breaks the Metro bundle outright, and would put @reown/appkit
# back in the tree. Web connects through EIP-6963 (browser extensions) only.
# This is here for the Android build, where WalletConnect is the mechanism.
# See apps/app/src/wallet/connectors.ts.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Which Arc network the app targets. Unset means testnet, which is the safe
# default; an id that is not an Arc network fails at startup rather than
# quietly falling back.
EXPO_PUBLIC_ARC_CHAIN_ID=

# Where the app finds the API. No default to production: a build that silently
# pointed a developer's wallet at the live API would be a surprise in exactly
# one direction.
EXPO_PUBLIC_API_URL=http://localhost:3000
# The authority the wallet is asked to sign for, and it must equal the API's
# SIWE_DOMAIN exactly or every signature is rejected with nothing in either
# side's logs to explain it. WEB IGNORES THIS and reads the host from the page,
# which is the only value that cannot disagree with the address bar. Native has
# no page, so native needs it.
EXPO_PUBLIC_SIWE_DOMAIN=localhost:8081

# The deployed raffle contract, which the app reads directly — Section 4.2
# makes the chain the source of truth, so the screens never ask the API what a
# prize is. Unset, the app fails loudly rather than rendering an empty list that
# looks like "no draws yet".
EXPO_PUBLIC_RAFFLE_ADDRESS=
# Optional: a paid or private RPC. Falls back to the public endpoint pinned in
# packages/shared/src/chains.ts.
EXPO_PUBLIC_ARC_RPC_URL=


